# Copia este archivo como .env y completa tus llaves reales de Supabase.
# Nunca subas el archivo .env al repositorio (este repositorio es público).
# Los valores de abajo son solo marcadores, no credenciales reales.
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Compatibilidad: si tu proyecto usa la llave con el nombre anterior,
# también se lee VITE_SUPABASE_ANON_KEY como respaldo.
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Número de WhatsApp de la consultora (código de país + número, sin + ni espacios)
VITE_WHATSAPP_NUMBER=5215571741465
